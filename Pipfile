[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
pyinstaller = ">=6.4"
pylint = "*"
yapf = "*"
pytest = "*"
debugpy = "*"

[packages]
requests = {extras = ["socks"], version = "*"}
semver = "*"
python-dateutil = "*"
# PySide6's universal2 wheel sets the app's minimum macOS. 6.9.x is the last
# series built for macOS 12 Monterey, which is EVE Online's own minimum;
# 6.10 raises it to 13 and 6.12 to 14. 6.8.0.2 is the first to support 3.13.
pyside6 = ">=6.8.0.2,<6.10"
typing-extensions = "*"
appdirs = "*"

[requires]
python_version = "3.13"
